rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isChatMember(chatId) {
      return signedIn()
        && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.members;
    }

    // A user may access only their own profile and preferences.
    match /users/{userId} {
      allow read, create, update, delete: if signedIn()
        && request.auth.uid == userId;
    }

    // Private one-to-one conversations.
    match /chats/{chatId} {
      allow create: if signedIn()
        && request.auth.uid in request.resource.data.members
        && request.resource.data.members is list
        && request.resource.data.members.size() == 2;
      allow read: if signedIn() && request.auth.uid in resource.data.members;
      allow update: if signedIn()
        && request.auth.uid in resource.data.members
        && request.resource.data.members == resource.data.members;
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if isChatMember(chatId);
        allow create: if isChatMember(chatId)
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.recipientId in get(/databases/$(database)/documents/chats/$(chatId)).data.members
          && request.resource.data.recipientId != request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 5000;
        allow update, delete: if false;
      }
    }
  }
}
